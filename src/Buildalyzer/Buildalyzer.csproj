<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../package.props" />
  
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <FullFrameworkLoggerTargetFramework>net472</FullFrameworkLoggerTargetFramework>
    <FullFrameworkLoggerOutputSubdirectory>Buildalyzer.Logger\$(FullFrameworkLoggerTargetFramework)\</FullFrameworkLoggerOutputSubdirectory>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);PackFullFrameworkLogger</TargetsForTfmSpecificBuildOutput>
    <PackageId>Buildalyzer</PackageId>
    <PackageValidationBaselineVersion>7.0.1</PackageValidationBaselineVersion>
    <OutputType>library</OutputType>
    <PackageReleaseNotes>
      <![CDATA[
ToBeReleased
- Drop Buildalyzer.EmptyDisposable. (BREAKING)
- Publish SBOM.
]]>
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build" Version="18.7.1" />
    <PackageReference Include="Microsoft.Build.Framework" Version="18.7.1" />
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="18.7.1" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.7.1" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" Version="5.3.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyModel" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
    <PackageReference Include="MSBuild.StructuredLogger" Version="2.3.204" Aliases="StructuredLogger" />
    <PackageReference Include="MsBuildPipeLogger.Server" Version="1.1.6" />
    <PackageReference Include="NuGet.Frameworks" Version="7.6.0" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Buildalyzer.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Buildalyzer.Workspaces</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Buildalyzer.Logger/Buildalyzer.Logger.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.Sbom.Targets" Version="4.1.5" />
    <PackageReference Update="Roslynator.Analyzers" Version="4.15.0" />
  </ItemGroup>

  <Target Name="CopyFullFrameworkLogger" BeforeTargets="CopyFilesToOutputDirectory" Condition="'$(TargetFramework)' != '' and '$(TargetFramework)' != '$(FullFrameworkLoggerTargetFramework)'">
    <PropertyGroup>
      <_FullFrameworkLoggerBaseOutputPath>$([MSBuild]::EnsureTrailingSlash($(BaseOutputPath)))Buildalyzer.Logger\</_FullFrameworkLoggerBaseOutputPath>
      <_FullFrameworkLoggerBaseIntermediateOutputPath>$([MSBuild]::EnsureTrailingSlash($(BaseIntermediateOutputPath)))Buildalyzer.Logger\</_FullFrameworkLoggerBaseIntermediateOutputPath>
      <_FullFrameworkLoggerBuildProperties>TargetFramework=$(FullFrameworkLoggerTargetFramework);TargetFrameworks=$(FullFrameworkLoggerTargetFramework);Configuration=$(Configuration);Platform=$(Platform);BaseOutputPath=$(_FullFrameworkLoggerBaseOutputPath);BaseIntermediateOutputPath=$(_FullFrameworkLoggerBaseIntermediateOutputPath)</_FullFrameworkLoggerBuildProperties>
    </PropertyGroup>

    <MSBuild Projects="../Buildalyzer.Logger/Buildalyzer.Logger.csproj" Targets="Restore;Build" Properties="$(_FullFrameworkLoggerBuildProperties)" BuildInParallel="false" RemoveProperties="RuntimeIdentifier;SelfContained;PublishSelfContained;PublishDir;OutputPath" Condition="'$(NoBuild)' != 'true'" />

    <MSBuild Projects="../Buildalyzer.Logger/Buildalyzer.Logger.csproj" Targets="GetLoggerRuntimeFiles" Properties="$(_FullFrameworkLoggerBuildProperties)" BuildInParallel="false" RemoveProperties="RuntimeIdentifier;SelfContained;PublishSelfContained;PublishDir;OutputPath">
      <Output TaskParameter="TargetOutputs" ItemName="_FullFrameworkLoggerFile" />
    </MSBuild>

    <Copy SourceFiles="@(_FullFrameworkLoggerFile)" DestinationFolder="$(TargetDir)$(FullFrameworkLoggerOutputSubdirectory)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="AddFullFrameworkLoggerToCopyOutput" BeforeTargets="_GetCopyToOutputDirectoryItemsFromThisProject;GetCopyToPublishDirectoryItems" DependsOnTargets="CopyFullFrameworkLogger" Condition="'$(TargetFramework)' != '' and '$(TargetFramework)' != '$(FullFrameworkLoggerTargetFramework)'">
    <ItemGroup>
      <_FullFrameworkLoggerCopiedFile Include="$(TargetDir)$(FullFrameworkLoggerOutputSubdirectory)**\*.*" />
    </ItemGroup>

    <AssignTargetPath Files="@(_FullFrameworkLoggerCopiedFile)" RootFolder="$(TargetDir)">
      <Output TaskParameter="AssignedFiles" ItemName="_FullFrameworkLoggerCopiedFileWithTargetPath" />
    </AssignTargetPath>

    <ItemGroup>
      <ContentWithTargetPath Include="@(_FullFrameworkLoggerCopiedFileWithTargetPath)">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ContentWithTargetPath>
    </ItemGroup>
  </Target>

  <Target Name="PackFullFrameworkLogger" DependsOnTargets="CopyFullFrameworkLogger" Condition="'$(TargetFramework)' != '' and '$(TargetFramework)' != '$(FullFrameworkLoggerTargetFramework)'">
    <ItemGroup>
      <_FullFrameworkLoggerPackageFile Include="$(TargetDir)$(FullFrameworkLoggerOutputSubdirectory)**\*.*" />
    </ItemGroup>

    <AssignTargetPath Files="@(_FullFrameworkLoggerPackageFile)" RootFolder="$(TargetDir)">
      <Output TaskParameter="AssignedFiles" ItemName="_FullFrameworkLoggerPackageFileWithTargetPath" />
    </AssignTargetPath>

    <ItemGroup>
      <BuildOutputInPackage Include="@(_FullFrameworkLoggerPackageFileWithTargetPath)" />
    </ItemGroup>
  </Target>

</Project>
